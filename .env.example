# ─────────────────────────────────────────────────────────────────────
# Servidor MCP do Gmail pessoal — variáveis de ambiente
# Copie para .env (local) ou cadastre na Railway (Variables). NUNCA commite valores reais.
# ─────────────────────────────────────────────────────────────────────

NODE_ENV=production
# A Railway define PORT sozinha; localmente, 3000.
# PORT=3000

# URL pública do servidor, SEM barra no final (domínio gerado na Railway).
PUBLIC_BASE_URL=https://SEU-SERVICO.up.railway.app

# Única conta Google que pode autorizar.
ALLOWED_GOOGLE_EMAIL=leonunezcampos@gmail.com
# Nome exibido no remetente (opcional).
SENDER_NAME=

# Credenciais OAuth do Google Cloud (tipo "Aplicativo da Web").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 bytes aleatórios em base64. Gere com: npm run gen-key
# Cifra o refresh token do Google (AES-256-GCM) e assina links de anexos.
# Se trocar esta chave, será preciso reconectar o conector.
TOKEN_ENCRYPTION_KEY=

# Supabase (Settings → API Keys). Use a chave SECRETA (service_role / sb_secret_...), nunca a publishable/anon.
STORE=supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Tokens emitidos ao Claude
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# Limites de envio
SEND_DAILY_LIMIT=50
SEND_MAX_RECIPIENTS=20
SEND_TIMEZONE=America/Sao_Paulo

# Assinatura anexada automaticamente (vazia = sem assinatura). Use \n para quebrar linha.
EMAIL_SIGNATURE=
# Versão HTML opcional (se vazia, é derivada da versão em texto).
EMAIL_SIGNATURE_HTML=

# Anexos: até INLINE volta no próprio resultado; acima (até MAX) volta link temporário.
ATTACHMENT_INLINE_MAX_BYTES=5242880
ATTACHMENT_MAX_BYTES=26214400
DOWNLOAD_LINK_TTL_SECONDS=600

# Rate limit do endpoint /mcp (requisições por minuto, por token)
MCP_RATE_LIMIT_PER_MINUTE=120

# ── Somente desenvolvimento (proibidos com NODE_ENV=production) ──
# ALLOW_LOCALHOST_REDIRECTS=1   # aceita redirect em localhost (MCP Inspector)
# DEV_FAKE_GOOGLE=1             # login do Google simulado
# GMAIL_MOCK=1                  # Gmail simulado em memória
